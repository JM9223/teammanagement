<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>팀 편성 관리 (조합 기반)</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Pretendard', -apple-system, sans-serif; background: #f5f6f8; color: #222; padding: 24px; }
  h1 { font-size: 22px; margin-bottom: 16px; }
  h2 { font-size: 17px; margin: 16px 0 10px; }
  .tabs { display: flex; gap: 4px; margin-bottom: 16px; border-bottom: 1px solid #d1d5db; flex-wrap: wrap; }
  .tab { padding: 10px 16px; cursor: pointer; border: none; background: none; font-size: 14px; color: #6b7280; }
  .tab.active { color: #2563eb; border-bottom: 2px solid #2563eb; font-weight: 600; }
  .panel { display: none; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; }
  .panel.active { display: block; }
  .form-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; align-items: center; }
  input, select, button { padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; font-family: inherit; }
  input { flex: 1; min-width: 100px; }
  button { background: #2563eb; color: #fff; border: none; cursor: pointer; }
  button:hover { background: #1d4ed8; }
  button.danger { background: #dc2626; }
  button.ghost { background: #fff; color: #374151; border: 1px solid #d1d5db; }
  button.toggle { background: #e5e7eb; color: #374151; padding: 4px 10px; font-size: 12px; }
  button.toggle.on { background: #10b981; color: #fff; }
  button.toggle.off { background: #ef4444; color: #fff; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { padding: 8px; text-align: left; border-bottom: 1px solid #e5e7eb; }
  th { background: #f9fafb; font-weight: 600; color: #374151; }
  td.num, th.num { text-align: right; }
  td.center, th.center { text-align: center; }
  .empty { text-align: center; color: #9ca3af; padding: 20px; }
  .scroll-x { overflow-x: auto; }
  .pick-list { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; min-height: 44px; margin-bottom: 8px; }
  .chip { padding: 4px 10px; border-radius: 4px; font-size: 13px; cursor: pointer; border: 1px solid #d1d5db; background: #fff; }
  .chip.selected-a { background: #dbeafe; border-color: #2563eb; color: #1e40af; }
  .chip.selected-b { background: #fee2e2; border-color: #dc2626; color: #991b1b; }
  .chip.selected { background: #ede9fe; border-color: #7c3aed; color: #5b21b6; }
  .team-box { border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px; margin-bottom: 12px; }
  .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
  .winner { background: #ecfdf5; padding: 2px 6px; border-radius: 4px; color: #047857; font-size: 12px; }
  .bar { background: #e5e7eb; height: 8px; border-radius: 4px; overflow: hidden; margin: 4px 0; }
  .bar > div { height: 100%; background: #2563eb; }
  .hint { color: #6b7280; font-size: 12px; margin-bottom: 10px; }
  .pos { color: #047857; font-weight: 600; }
  .neg { color: #b91c1c; font-weight: 600; }
</style>
</head>
<body>

<h1>팀 편성 관리 · 조합 기반</h1>

<div class="tabs">
  <button class="tab active" data-tab="members">팀원 관리</button>
  <button class="tab" data-tab="events">참가 신청</button>
  <button class="tab" data-tab="matches">경기 결과</button>
  <button class="tab" data-tab="combos">조합 분석</button>
  <button class="tab" data-tab="balance">자동 팀 편성</button>
</div>

<!-- 1. 팀원 -->
<div class="panel active" id="members">
  <h2>팀원 등록</h2>
  <div class="form-row">
    <input id="m-name" placeholder="이름">
    <select id="m-gender"><option value="남">남</option><option value="여">여</option></select>
    <input id="m-age" type="number" placeholder="나이" min="1" max="120" style="max-width:100px">
    <button onclick="addMember()">등록</button>
  </div>
  <h2>팀원 목록 · 월별 회비</h2>
  <div class="scroll-x">
    <table id="m-table">
      <thead>
        <tr><th>이름</th><th>성별</th><th class="num">나이</th>
            <th class="center" colspan="12">월별 회비 (클릭 토글)</th><th>관리</th></tr>
        <tr><th></th><th></th><th></th>
            <th class="center">1</th><th class="center">2</th><th class="center">3</th>
            <th class="center">4</th><th class="center">5</th><th class="center">6</th>
            <th class="center">7</th><th class="center">8</th><th class="center">9</th>
            <th class="center">10</th><th class="center">11</th><th class="center">12</th><th></th></tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<!-- 2. 일정 -->
<div class="panel" id="events">
  <h2>일정 등록</h2>
  <div class="form-row">
    <input id="e-date" type="date">
    <input id="e-title" placeholder="일정 제목">
    <button onclick="addEvent()">등록</button>
  </div>
  <h2>일정별 참석 현황</h2>
  <div id="event-list"></div>
</div>

<!-- 3. 경기 결과 -->
<div class="panel" id="matches">
  <h2>경기 결과 등록</h2>
  <div class="form-row">
    <input id="r-date" type="date">
    <button onclick="setSelMode('A')" class="ghost">A팀 선택</button>
    <button onclick="setSelMode('B')" class="ghost">B팀 선택</button>
    <button onclick="clearSel()" class="ghost">초기화</button>
  </div>
  <div class="hint">팀원 클릭으로 A/B팀 배정 (현재 모드: <strong id="sel-mode">A</strong>)</div>
  <div class="pick-list" id="pick-list"></div>
  <div class="form-row">
    <span>승자:</span>
    <select id="r-winner"><option value="A">A팀</option><option value="B">B팀</option><option value="draw">무승부</option></select>
    <button onclick="addMatch()">경기 결과 저장</button>
  </div>
  <h2>경기 기록</h2>
  <div id="match-list"></div>
</div>

<!-- 4. 조합 분석 -->
<div class="panel" id="combos">
  <h2>같은 팀 조합 승률 (시너지)</h2>
  <div class="hint">두 명이 같은 팀이었을 때 그 팀의 승률 · 2경기 이상만 표시 · 승률 높은 순</div>
  <div class="scroll-x"><table id="syn-table"></table></div>

  <h2 style="margin-top:20px;">맞대결 전적</h2>
  <div class="hint">A vs B로 만났을 때 왼쪽 선수 기준 승률</div>
  <div class="scroll-x"><table id="vs-table"></table></div>
</div>

<!-- 5. 자동 편성 -->
<div class="panel" id="balance">
  <h2>참가자 선택</h2>
  <div class="pick-list" id="bal-pick"></div>
  <div class="form-row">
    <button onclick="balanceTeams()">조합 기반 자동 편성</button>
    <span class="hint" style="margin:0;">선택한 인원을 2팀으로 분할 (인원차 0~1명)</span>
  </div>
  <p class="hint">
    가능한 모든 분할을 평가하여 <strong>맞대결 예상 승률이 50%에 가장 가까운 조합</strong>을 선택합니다.
    (17명 이상은 swap 휴리스틱 사용) 데이터가 없는 페어는 50%로 가정합니다.
  </p>
  <div id="bal-result"></div>
</div>

<script>
const state = {
  members: JSON.parse(localStorage.getItem('members') || '[]'),
  events:  JSON.parse(localStorage.getItem('events')  || '[]'),
  fees:    JSON.parse(localStorage.getItem('fees')    || '{}'),
  attend:  JSON.parse(localStorage.getItem('attend')  || '{}'),
  matches: JSON.parse(localStorage.getItem('matches') || '[]'),
};
const save = () => { Object.keys(state).forEach(k => localStorage.setItem(k, JSON.stringify(state[k]))); };
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
const findName = id => (state.members.find(m => m.id === id) || {}).name || '?';
const pairKey = (a,b) => a < b ? a+'|'+b : b+'|'+a;

document.querySelectorAll('.tab').forEach(btn => {
  btn.onclick = () => {
    document.querySelectorAll('.tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(btn.dataset.tab).classList.add('active');
    if (btn.dataset.tab === 'matches') { renderPickList(); renderMatches(); }
    if (btn.dataset.tab === 'combos') { renderCombos(); }
    if (btn.dataset.tab === 'balance') { renderBalPick(); }
  };
});

// === 팀원 ===
function addMember() {
  const name = document.getElementById('m-name').value.trim();
  const gender = document.getElementById('m-gender').value;
  const age = parseInt(document.getElementById('m-age').value);
  if (!name || !age) { alert('이름과 나이를 입력하세요.'); return; }
  state.members.push({ id: uid(), name, gender, age });
  document.getElementById('m-name').value = '';
  document.getElementById('m-age').value = '';
  save(); renderAll();
}
function delMember(id) {
  if (!confirm('삭제하시겠습니까?')) return;
  state.members = state.members.filter(m => m.id !== id);
  delete state.fees[id];
  Object.keys(state.attend).forEach(eid => delete state.attend[eid][id]);
  save(); renderAll();
}
function toggleFee(memberId, month) {
  state.fees[memberId] = state.fees[memberId] || {};
  state.fees[memberId][month] = !state.fees[memberId][month];
  save(); renderMembers();
}
function renderMembers() {
  const tbody = document.querySelector('#m-table tbody');
  if (state.members.length === 0) {
    tbody.innerHTML = `<tr><td colspan="16" class="empty">등록된 팀원이 없습니다.</td></tr>`; return;
  }
  tbody.innerHTML = state.members.map(m => {
    const fees = state.fees[m.id] || {};
    const cells = Array.from({length: 12}, (_, i) => {
      const month = i + 1, paid = !!fees[month];
      return `<td class="center"><button class="toggle ${paid?'on':'off'}" onclick="toggleFee('${m.id}',${month})">${paid?'납부':'미납'}</button></td>`;
    }).join('');
    return `<tr><td>${m.name}</td><td>${m.gender}</td><td class="num">${m.age}</td>${cells}
      <td><button class="danger" onclick="delMember('${m.id}')">삭제</button></td></tr>`;
  }).join('');
}

// === 일정 ===
function addEvent() {
  const date = document.getElementById('e-date').value;
  const title = document.getElementById('e-title').value.trim();
  if (!date || !title) return alert('날짜와 제목을 입력하세요.');
  state.events.push({ id: uid(), date, title });
  state.events.sort((a,b) => a.date.localeCompare(b.date));
  document.getElementById('e-date').value = '';
  document.getElementById('e-title').value = '';
  save(); renderEvents();
}
function delEvent(id) {
  if (!confirm('일정을 삭제하시겠습니까?')) return;
  state.events = state.events.filter(e => e.id !== id);
  delete state.attend[id];
  save(); renderEvents();
}
function toggleAttend(eventId, memberId) {
  state.attend[eventId] = state.attend[eventId] || {};
  state.attend[eventId][memberId] = !state.attend[eventId][memberId];
  save(); renderEvents();
}
function renderEvents() {
  const list = document.getElementById('event-list');
  if (state.events.length === 0) { list.innerHTML = `<div class="empty">등록된 일정이 없습니다.</div>`; return; }
  list.innerHTML = state.events.map(e => {
    const att = state.attend[e.id] || {};
    const count = state.members.filter(m => att[m.id]).length;
    const rows = state.members.length === 0
      ? `<tr><td colspan="4" class="empty">먼저 팀원을 등록하세요.</td></tr>`
      : state.members.map(m => {
          const yes = !!att[m.id];
          return `<tr><td>${m.name}</td><td>${m.gender}</td><td class="num">${m.age}</td>
            <td class="center"><button class="toggle ${yes?'on':'off'}" onclick="toggleAttend('${e.id}','${m.id}')">${yes?'참석':'불참'}</button></td></tr>`;
        }).join('');
    return `<div class="team-box">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <div><strong>${e.title}</strong> <span style="color:#6b7280;margin-left:8px;">${e.date}</span>
          <span style="color:#2563eb;margin-left:12px;">참석 ${count}/${state.members.length}명</span></div>
        <button class="danger" onclick="delEvent('${e.id}')">일정 삭제</button></div>
      <table><thead><tr><th>이름</th><th>성별</th><th class="num">나이</th><th class="center">참석</th></tr></thead>
        <tbody>${rows}</tbody></table></div>`;
  }).join('');
}

// === 경기 결과 ===
let selMode = 'A';
const selA = new Set(), selB = new Set();
function setSelMode(m) { selMode = m; document.getElementById('sel-mode').textContent = m; }
function clearSel() { selA.clear(); selB.clear(); renderPickList(); }
function togglePick(id) {
  if (selA.has(id)) selA.delete(id);
  else if (selB.has(id)) selB.delete(id);
  else (selMode === 'A' ? selA : selB).add(id);
  renderPickList();
}
function renderPickList() {
  const el = document.getElementById('pick-list');
  if (state.members.length === 0) { el.innerHTML = '<span style="color:#9ca3af;">팀원을 먼저 등록하세요.</span>'; return; }
  el.innerHTML = state.members.map(m => {
    const cls = selA.has(m.id) ? 'selected-a' : selB.has(m.id) ? 'selected-b' : '';
    const tag = selA.has(m.id) ? ' (A)' : selB.has(m.id) ? ' (B)' : '';
    return `<span class="chip ${cls}" onclick="togglePick('${m.id}')">${m.name}${tag}</span>`;
  }).join('');
}
function addMatch() {
  const date = document.getElementById('r-date').value;
  const winner = document.getElementById('r-winner').value;
  if (!date) return alert('날짜를 입력하세요.');
  if (selA.size === 0 || selB.size === 0) return alert('A팀, B팀 모두 선택하세요.');
  state.matches.push({ id: uid(), date, teamA: [...selA], teamB: [...selB], winner });
  state.matches.sort((a,b) => b.date.localeCompare(a.date));
  clearSel(); save(); renderMatches();
}
function delMatch(id) {
  if (!confirm('경기 기록을 삭제하시겠습니까?')) return;
  state.matches = state.matches.filter(m => m.id !== id);
  save(); renderMatches(); renderCombos();
}
function renderMatches() {
  const list = document.getElementById('match-list');
  if (state.matches.length === 0) { list.innerHTML = `<div class="empty">등록된 경기가 없습니다.</div>`; return; }
  list.innerHTML = state.matches.map(m => {
    const a = m.teamA.map(findName).join(', '), b = m.teamB.map(findName).join(', ');
    const wTxt = m.winner === 'A' ? 'A팀 승' : m.winner === 'B' ? 'B팀 승' : '무승부';
    return `<div class="team-box">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
        <div><strong>${m.date}</strong> <span class="winner">${wTxt}</span></div>
        <button class="danger" onclick="delMatch('${m.id}')">삭제</button></div>
      <div style="font-size:13px;"><strong>A팀:</strong> ${a}</div>
      <div style="font-size:13px;"><strong>B팀:</strong> ${b}</div></div>`;
  }).join('');
}

// === 조합 통계 ===
function calcCombos() {
  const together = {}; // pairKey -> {games, score}
  const versus = {};   // a -> b -> {games, score(a입장)}
  state.matches.forEach(m => {
    const sA = m.winner === 'A' ? 1 : m.winner === 'draw' ? 0.5 : 0;
    const sB = 1 - sA;
    [[m.teamA, sA], [m.teamB, sB]].forEach(([team, s]) => {
      for (let i = 0; i < team.length; i++) for (let j = i+1; j < team.length; j++) {
        const k = pairKey(team[i], team[j]);
        together[k] = together[k] || { games: 0, score: 0 };
        together[k].games++; together[k].score += s;
      }
    });
    m.teamA.forEach(a => m.teamB.forEach(b => {
      versus[a] = versus[a] || {};
      versus[a][b] = versus[a][b] || { games: 0, score: 0 };
      versus[a][b].games++; versus[a][b].score += sA;
      versus[b] = versus[b] || {};
      versus[b][a] = versus[b][a] || { games: 0, score: 0 };
      versus[b][a].games++; versus[b][a].score += sB;
    }));
  });
  return { together, versus };
}

function renderCombos() {
  const { together, versus } = calcCombos();
  // 시너지 테이블
  const synRows = Object.entries(together)
    .filter(([k,v]) => v.games >= 2)
    .map(([k,v]) => {
      const [a,b] = k.split('|');
      return { a, b, games: v.games, rate: v.score/v.games };
    })
    .sort((x,y) => y.rate - x.rate);
  const synHTML = `
    <thead><tr><th>선수 A</th><th>선수 B</th><th class="num">함께 뛴 경기</th><th class="num">승률</th><th>분포</th></tr></thead>
    <tbody>${synRows.length === 0 ? `<tr><td colspan="5" class="empty">2경기 이상 함께 뛴 페어 없음</td></tr>` :
      synRows.map(r => {
        const cls = r.rate >= 0.6 ? 'pos' : r.rate <= 0.4 ? 'neg' : '';
        return `<tr><td>${findName(r.a)}</td><td>${findName(r.b)}</td>
          <td class="num">${r.games}</td>
          <td class="num ${cls}">${(r.rate*100).toFixed(0)}%</td>
          <td style="min-width:120px;"><div class="bar"><div style="width:${r.rate*100}%"></div></div></td></tr>`;
      }).join('')
    }</tbody>`;
  document.getElementById('syn-table').innerHTML = synHTML;

  // 맞대결 테이블
  const vsRows = [];
  Object.entries(versus).forEach(([a, opp]) => {
    Object.entries(opp).forEach(([b, v]) => {
      if (a < b && v.games >= 2) {
        vsRows.push({ a, b, games: v.games, rateA: v.score/v.games });
      }
    });
  });
  vsRows.sort((x,y) => Math.abs(y.rateA - 0.5) - Math.abs(x.rateA - 0.5));
  const vsHTML = `
    <thead><tr><th>왼쪽 선수</th><th>vs</th><th>오른쪽 선수</th><th class="num">맞대결 경기</th><th class="num">왼쪽 승률</th></tr></thead>
    <tbody>${vsRows.length === 0 ? `<tr><td colspan="5" class="empty">2경기 이상 맞붙은 페어 없음</td></tr>` :
      vsRows.map(r => {
        const cls = r.rateA >= 0.6 ? 'pos' : r.rateA <= 0.4 ? 'neg' : '';
        return `<tr><td>${findName(r.a)}</td><td style="color:#9ca3af;">vs</td><td>${findName(r.b)}</td>
          <td class="num">${r.games}</td>
          <td class="num ${cls}">${(r.rateA*100).toFixed(0)}%</td></tr>`;
      }).join('')
    }</tbody>`;
  document.getElementById('vs-table').innerHTML = vsHTML;
}

// === 자동 편성 (조합 기반) ===
const balSel = new Set();
function toggleBal(id) { balSel.has(id) ? balSel.delete(id) : balSel.add(id); renderBalPick(); }
function renderBalPick() {
  const el = document.getElementById('bal-pick');
  if (state.members.length === 0) { el.innerHTML = '<span style="color:#9ca3af;">팀원을 먼저 등록하세요.</span>'; return; }
  el.innerHTML = state.members.map(m =>
    `<span class="chip ${balSel.has(m.id)?'selected':''}" onclick="toggleBal('${m.id}')">${m.name}</span>`
  ).join('');
}

function evalSplit(teamA, teamB, combos) {
  const { together, versus } = combos;
  const teamSyn = team => {
    let sum = 0, cnt = 0;
    for (let i = 0; i < team.length; i++) for (let j = i+1; j < team.length; j++) {
      const t = together[pairKey(team[i], team[j])];
      sum += (t && t.games) ? t.score/t.games : 0.5; cnt++;
    }
    return cnt === 0 ? 0.5 : sum/cnt;
  };
  let mSum = 0, mCnt = 0;
  teamA.forEach(a => teamB.forEach(b => {
    const v = versus[a] && versus[a][b];
    mSum += (v && v.games) ? v.score/v.games : 0.5; mCnt++;
  }));
  return {
    synA: teamSyn(teamA),
    synB: teamSyn(teamB),
    matchExp: mCnt === 0 ? 0.5 : mSum/mCnt
  };
}

function* combinations(arr, k) {
  if (k === 0) { yield []; return; }
  if (arr.length < k) return;
  const [first, ...rest] = arr;
  for (const c of combinations(rest, k-1)) yield [first, ...c];
  for (const c of combinations(rest, k)) yield c;
}

function bestSplitBrute(ids, combos) {
  const halfA = Math.ceil(ids.length / 2);
  let best = null;
  for (const tA of combinations(ids, halfA)) {
    const setA = new Set(tA);
    const tB = ids.filter(x => !setA.has(x));
    const ev = evalSplit(tA, tB, combos);
    const score = Math.abs(ev.matchExp - 0.5);
    if (!best || score < best.score) best = { teamA: tA, teamB: tB, ...ev, score };
  }
  return best;
}

function bestSplitHeuristic(ids, combos) {
  const half = Math.ceil(ids.length / 2);
  let best = null;
  for (let trial = 0; trial < 300; trial++) {
    const sh = [...ids].sort(() => Math.random() - 0.5);
    let tA = sh.slice(0, half), tB = sh.slice(half);
    let ev = evalSplit(tA, tB, combos);
    let cs = Math.abs(ev.matchExp - 0.5);
    let improved = true;
    while (improved) {
      improved = false;
      for (let i = 0; i < tA.length && !improved; i++) {
        for (let j = 0; j < tB.length; j++) {
          const nA = [...tA], nB = [...tB];
          [nA[i], nB[j]] = [nB[j], nA[i]];
          const e2 = evalSplit(nA, nB, combos);
          const s2 = Math.abs(e2.matchExp - 0.5);
          if (s2 < cs - 1e-6) { tA = nA; tB = nB; ev = e2; cs = s2; improved = true; break; }
        }
      }
    }
    if (!best || cs < best.score) best = { teamA: tA, teamB: tB, ...ev, score: cs };
  }
  return best;
}

function balanceTeams() {
  if (balSel.size < 2) return alert('최소 2명을 선택하세요.');
  const ids = [...balSel];
  const combos = calcCombos();
  const result = ids.length <= 16 ? bestSplitBrute(ids, combos) : bestSplitHeuristic(ids, combos);
  const teamHTML = (label, team, syn) => {
    return `<div class="team-box">
      <h3 style="font-size:15px; margin-bottom:6px;">${label} (${team.length}명)
        <span style="color:#6b7280; font-size:12px; margin-left:6px;">팀 시너지 ${(syn*100).toFixed(0)}%</span></h3>
      <div>${team.map(id => `<span class="chip" style="margin:2px;">${findName(id)}</span>`).join('')}</div>
    </div>`;
  };
  const expA = (result.matchExp*100).toFixed(1);
  const expB = ((1-result.matchExp)*100).toFixed(1);
  document.getElementById('bal-result').innerHTML = `
    <div class="team-grid">
      ${teamHTML('A팀', result.teamA, result.synA)}
      ${teamHTML('B팀', result.teamB, result.synB)}
    </div>
    <div class="team-box" style="margin-top:8px;">
      <div style="font-size:14px; margin-bottom:6px;">
        <strong>맞대결 예상 승률</strong> · A팀 ${expA}% vs B팀 ${expB}%
      </div>
      <div class="bar" style="height:14px;"><div style="width:${expA}%"></div></div>
      <div class="hint" style="margin-top:6px;">50%에 가까울수록 균형 잡힌 매치업입니다. 경기 데이터가 쌓일수록 정확도가 올라갑니다.</div>
    </div>`;
}

function renderAll() { renderMembers(); renderEvents(); renderPickList(); renderMatches(); renderBalPick(); renderCombos(); }
renderAll();
</script>

